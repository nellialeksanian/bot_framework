# Copy to .env.acceptance in the repository root. NEVER commit filled-in values.
# Use dedicated test bots, not tokens from production polling processes.
LLM_PROVIDER=hub
LOCAL_HUB_API_BASE=https://your-hub.example/ai/v1
LOCAL_HUB_API_KEY=
LOCAL_HUB_MODEL_NAME=qwen3.8-27b-w4a16-awq
LOCAL_HUB_REQUEST_INTERVAL=2
LOCAL_HUB_STREAMING=false
LOCAL_HUB_VERIFY_SSL=true
# Prefer a private CA; disable verification only deliberately for this test environment.
# LOCAL_HUB_CA_BUNDLE=C:/certs/hub-ca.pem

# Choose the actual backup available on your hub; no invented model default.
LLM_FALLBACK_ENABLED=true
LLM_FALLBACK_PROVIDER=hub
LOCAL_HUB_FALLBACK_MODEL_NAME=
# Optional direct 302.ai backup. Enable explicitly and fill its key/model.
LLM_DIRECT_FALLBACK=false
API_302AI_KEY=
A302_API_BASE=https://api.302.ai/v1
A302_MODEL_NAME=
A302_MODE=chat

LLM_TIMEOUT=180
LLM_PRIMARY_TIMEOUT=60
LLM_MAX_RETRIES=0
LLM_VERIFY_SSL=true
LLM_TRUST_ENV=true
PRICE_FILE=config/prices.json

TELEGRAM_BOT_TOKEN=
VK_BOT_TOKEN=
# No chat/user IDs needed: the harness replies to everyone in the originating chat.
# Old ACCEPTANCE_*_CHAT_ID / ACCEPTANCE_*_USER_IDS settings are ignored.

MAX_ATTACHMENT_BYTES=5242880
EXTRACTION_PDF_MODE=auto
EXTRACTION_VISION_TIMEOUT=180
# The messenger harness additionally caps each document to 3 pages / 2 vision pages.
