# Copy to .env and supply your values; never commit real credentials.
LLM_PROVIDER=hub
LOCAL_HUB_API_BASE=https://your-hub.example/ai/v1
LOCAL_HUB_API_KEY=
LOCAL_HUB_MODEL_NAME=qwen3.8-27b-w4a16-awq
LOCAL_HUB_FALLBACK_MODEL_NAME=gpt-model-name

# Qwen -> another model on the hub. Keeps old organizer_bot2 environment names.
LLM_FALLBACK_ENABLED=true
LLM_FALLBACK_PROVIDER=hub
# Optional override for LOCAL_HUB_FALLBACK_MODEL_NAME:
# LLM_FALLBACK_MODEL=
# Explicit opt-in: when the entire hub is down, try 302.ai directly.
LLM_DIRECT_FALLBACK=false
LLM_TIMEOUT=300
LLM_PRIMARY_TIMEOUT=90
LLM_MAX_RETRIES=2
LOCAL_HUB_REQUEST_INTERVAL=2
LOCAL_HUB_STREAMING=false

API_302AI_KEY=
A302_API_BASE=https://api.302.ai/v1
A302_MODEL_NAME=gpt-5.5
A302_MODE=chat

# Standalone vLLM, if LLM_PROVIDER=vllm:
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=your-served-model
VLLM_API_KEY=

# Keep TLS verification enabled. Use your CA bundle for a private certificate.
LOCAL_HUB_VERIFY_SSL=true
# LOCAL_HUB_CA_BUNDLE=C:/certs/hub-ca.pem
LLM_VERIFY_SSL=true
# LLM_CA_BUNDLE=C:/certs/provider-ca.pem
LLM_TRUST_ENV=true

BOT_ID=example-bot
VK_BOT_TOKEN=
TELEGRAM_BOT_TOKEN=
USAGE_DB=data/usage.sqlite3
PRICE_FILE=config/prices.json
LOG_TEXT=false
LOG_TEXT_LIMIT=20000
MAX_ATTACHMENT_BYTES=20971520

# A5. auto: text layer first; scanned/image-heavy pages go to the vision model.
# text: local extraction only; vision: send every rendered page to the model.
EXTRACTION_PDF_MODE=auto
EXTRACTION_MAX_PAGES=30
EXTRACTION_MAX_VISION_PAGES=10
EXTRACTION_MAX_TEXT_CHARS=200000
EXTRACTION_RENDER_DPI=144
EXTRACTION_VISION_TIMEOUT=180
