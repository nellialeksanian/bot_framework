# Copy to .env and supply your values; never commit real credentials.
LLM_PROVIDER=hub
LOCAL_HUB_API_BASE=https://your-hub.example/ai/v1
LOCAL_HUB_API_KEY=
LOCAL_HUB_MODEL_NAME=qwen3.8-27b-w4a16-awq
LOCAL_HUB_FALLBACK_MODEL_NAME=gpt-model-name

# Qwen -> another model on the hub. Keeps old organizer_bot2 environment names.
LLM_FALLBACK_ENABLED=true
LLM_FALLBACK_PROVIDER=hub
# Optional override for LOCAL_HUB_FALLBACK_MODEL_NAME:
# LLM_FALLBACK_MODEL=
# Explicit opt-in: when the entire hub is down, try 302.ai directly.
LLM_DIRECT_FALLBACK=false
LLM_TIMEOUT=300
LLM_PRIMARY_TIMEOUT=90
LLM_MAX_RETRIES=2
LOCAL_HUB_REQUEST_INTERVAL=2
LOCAL_HUB_STREAMING=false

API_302AI_KEY=
A302_API_BASE=https://api.302.ai/v1
A302_MODEL_NAME=gpt-5.5
A302_MODE=chat

# Standalone vLLM, if LLM_PROVIDER=vllm:
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=your-served-model
VLLM_API_KEY=

# Keep TLS verification enabled. Use your CA bundle for a private certificate.
LOCAL_HUB_VERIFY_SSL=true
# LOCAL_HUB_CA_BUNDLE=C:/certs/hub-ca.pem
LLM_VERIFY_SSL=true
# LLM_CA_BUNDLE=C:/certs/provider-ca.pem
LLM_TRUST_ENV=true

BOT_ID=example-bot
VK_BOT_TOKEN=
TELEGRAM_BOT_TOKEN=
USAGE_DB=data/usage.sqlite3
PRICE_FILE=config/prices.json
LOG_TEXT=false
LOG_TEXT_LIMIT=20000
MAX_ATTACHMENT_BYTES=20971520

# A5. auto: text layer first; scanned/image-heavy pages go to the vision model.
# text: local extraction only; vision: send every rendered page to the model.
EXTRACTION_PDF_MODE=auto
EXTRACTION_MAX_PAGES=30
EXTRACTION_MAX_VISION_PAGES=10
EXTRACTION_MAX_TEXT_CHARS=200000
EXTRACTION_RENDER_DPI=144
EXTRACTION_VISION_TIMEOUT=180

# Optional speech recognition via Pneuma (independent of Qwen).
# Set ASR_PROVIDER=pneuma to enable; disabled means no ASR client or uploads.
ASR_PROVIDER=disabled
# legacy = POST /transcriptions; chunked = /uploads + PATCH + /complete.
# Kept legacy by default for existing integrations. Select chunked for the supplied new client.
PNEUMA_UPLOAD_PROTOCOL=legacy
# Chunked only. Blank = user_id from usage_context; use a pseudonymous ID.
PNEUMA_USER_ID=
PNEUMA_DEVICE=cuda
PNEUMA_CONNECT_TIMEOUT=15
# Optional durable resume metadata (no audio/text); blank = in-memory, TTL 24h.
PNEUMA_UPLOAD_STATE_DB=data/pneuma_uploads.sqlite3
# Direct API: server root or deployment prefix, WITHOUT /v1 or /transcriptions.
# Web proxy: include /api, e.g. https://pneuma.example/api, and use proxy mode.
PNEUMA_BASE_URL=https://pneuma.example
PNEUMA_API_MODE=direct
# Optional Bearer credential, only if the deployment's reverse proxy requires it.
PNEUMA_API_KEY=
PNEUMA_TIMEOUT=600
PNEUMA_REQUEST_TIMEOUT=180
PNEUMA_POLL_INTERVAL=2
PNEUMA_VERIFY_SSL=true
# PNEUMA_CA_BUNDLE=C:/certs/pneuma-ca.pem
PNEUMA_TRUST_ENV=true
PNEUMA_CANCEL_ON_TIMEOUT=true
# PNEUMA_API_MODE and CANCEL_ON_TIMEOUT apply only to legacy; chunked retains jobs on timeout.
EXTRACTION_AUDIO_TIMEOUT=600

# Optional ASR -> local LLM punctuation/case cleanup. Disabled preserves the raw ASR workflow.
# Reuses LOCAL_HUB_* or VLLM_* credentials; never uses the main LLM fallback chain.
ASR_POSTPROCESS_ENABLED=false
ASR_POSTPROCESS_LLM_PROVIDER=hub
# Optional override; otherwise use LOCAL_HUB_MODEL_NAME / VLLM_MODEL.
ASR_POSTPROCESS_MODEL=
ASR_POSTPROCESS_TIMEOUT=30
ASR_POSTPROCESS_MAX_CHARS=20000
ASR_POSTPROCESS_MAX_TOKENS=8192
# raise = fail explicitly on LLM/JSON error; original = return original with warning metadata.
ASR_POSTPROCESS_ON_ERROR=raise
